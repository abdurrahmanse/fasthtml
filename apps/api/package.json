{
    "name": "@portfolio/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "/usr/bin/python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8080",
        "build": "/usr/bin/python3 -m py_compile app/main.py && mkdir -p build && cp -R app build/",
        "lint": "/usr/bin/python3 -m py_compile app/main.py"
    }
    ,"turbo": {
        "outputs": [
            "app/__pycache__/**",
            "app/**/*.pyc"
        ]
    }
}